# Moon Scanner — copy to .env and fill in (never commit real keys)

# --- Deploy ---
# MOON_SCANNER_DEPLOY=local
# PORT=8765

# --- Realtime (recommended paid path) ---
# Easiest: Helius free/paid key auto-wires WSS + HTTP
HELIUS_API_KEY=

# Or set endpoints explicitly (QuickNode, Triton, etc.)
# SOLANA_RPC_WSS=wss://YOUR-ENDPOINT
# SOLANA_RPC_HTTP=https://YOUR-ENDPOINT

# auto | transaction | logs
# auto = transactionSubscribe on paid WSS, logsSubscribe on public
SOLANA_WS_MODE=auto

# DISABLE_SOLANA_WS=1
# REALTIME_PUMP_POLL_SEC=3.0

# --- Security ---
# Required for POST /api/learning/reseed and /rebuild (and on production if unset, those routes 403)
ADMIN_API_KEY=

# Comma-separated browser origins. Empty = safe defaults (localhost or known Render URLs)
# CORS_ORIGINS=http://127.0.0.1:8765,https://moon-scanner-9tlz.onrender.com

# Expensive routes rate limit (moon/snipes/analyze) per client IP
# RATE_LIMIT_PER_MIN=45
# RATE_LIMIT_BURST=12

# Learning poll caps
# LEARNING_ACTIVE_CAP_PUBLIC=40
# LEARNING_ACTIVE_CAP_PAID=80

# Optional Yellowstone gRPC
# YELLOWSTONE_GRPC_ENDPOINT=https://yellowstone.example.com
# YELLOWSTONE_GRPC_TOKEN=
# YELLOWSTONE_COMMITMENT=processed
# YELLOWSTONE_ONLY=1

# Optional earliest shred layer
# SHREDSTREAM_ENDPOINT=
