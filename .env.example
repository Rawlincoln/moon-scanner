# Moon Scanner — copy to .env and fill in (never commit real keys)
#   copy .env.example .env

# --- Deploy ---
# MOON_SCANNER_DEPLOY=local
# PORT=8765

# =============================================================================
# Solana RPC — pick ONE path (you do NOT need a paid plan)
# =============================================================================
#
# A) FREE Helius developer key (easiest if signup allows free tier)
#    https://dashboard.helius.dev  → API Keys → create key
# HELIUS_API_KEY=
#
# B) FREE / freemium other providers (set BOTH HTTP + WSS, leave HELIUS empty)
#    Alchemy:  https://www.alchemy.com/   → Solana mainnet app
#    Ankr:     https://www.ankr.com/rpc/solana/
#    Shyft:    https://shyft.to/
#    QuickNode / Chainstack: free trial or free tier when available
#
# HELIUS_API_KEY=
# SOLANA_RPC_HTTP=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
# SOLANA_RPC_WSS=wss://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
#
# C) NO KEY — public RPC (works for moon/snipes; expect 429s on Solana WS)
#    Use start-free.bat  OR set the free-mode vars below.
# HELIUS_API_KEY=
# SOLANA_RPC_HTTP=
# SOLANA_RPC_WSS=
# DISABLE_SOLANA_WS=1
# REALTIME_PUMP_POLL_SEC=4
# LEARNING_ACTIVE_CAP_PUBLIC=25
# SOLANA_WS_MODE=logs
#
# =============================================================================

HELIUS_API_KEY=

# Explicit endpoints override Helius auto-wire when set:
# SOLANA_RPC_HTTP=https://YOUR-ENDPOINT
# SOLANA_RPC_WSS=wss://YOUR-ENDPOINT

# auto | transaction | logs
# auto = transactionSubscribe on paid WSS, logsSubscribe on public
SOLANA_WS_MODE=auto

# Free / low-RPC mode (also applied by start-free.bat):
# DISABLE_SOLANA_WS=1
# REALTIME_PUMP_POLL_SEC=4
# LEARNING_ACTIVE_CAP_PUBLIC=25

# --- Security ---
# Required for POST /api/learning/reseed and /rebuild
ADMIN_API_KEY=

# Comma-separated browser origins. Empty = safe defaults
# CORS_ORIGINS=http://127.0.0.1:8765,https://moon-scanner-9tlz.onrender.com

# Expensive routes rate limit per client IP
# RATE_LIMIT_PER_MIN=30
# RATE_LIMIT_BURST=8
# RATE_LIMIT_ANALYZE_PER_MIN=12
# RATE_LIMIT_FORCE_COST=4
# TRUST_X_FORWARDED_FOR=true
# ANALYZE_CONCURRENCY=4

# Learning poll caps
# LEARNING_ACTIVE_CAP_PUBLIC=40
# LEARNING_ACTIVE_CAP_PAID=80

# Optional Yellowstone gRPC
# YELLOWSTONE_GRPC_ENDPOINT=
# YELLOWSTONE_GRPC_TOKEN=
# YELLOWSTONE_COMMITMENT=processed
# YELLOWSTONE_ONLY=1

# Optional shred layer
# SHREDSTREAM_ENDPOINT=

# =============================================================================
# Telegram alerts (recommended — works with browser closed)
# =============================================================================
# 1) Telegram → search @BotFather → /newbot → copy token
# 2) Open your bot, press Start / send any message
# 3) Visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat":{"id": 123456789 }  ← that is TELEGRAM_CHAT_ID
# 4) Put both in .env and restart start.bat
#
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_ALERTS=1
# TELEGRAM_ALERT_FEEDS=moon,snipe,heat
# TELEGRAM_ALERT_INTERVAL_SEC=45
# TELEGRAM_ALERT_MOON_LABELS=MOON,WATCH
# TELEGRAM_ALERT_SNIPE_LABELS=SNIPE,SETUP
# TELEGRAM_ALERT_HEAT_LABELS=HEAT,WARM
# TELEGRAM_ALERT_DEDUPE_SEC=2700
# TELEGRAM_ALERT_MAX_PER_CYCLE=6
# For 24/7 on free Render, set a cron secret and hit tick every 2–3 min:
# TELEGRAM_CRON_SECRET=long-random-string
# https://YOUR.onrender.com/api/alerts/telegram/tick?key=long-random-string
#
# FOMO aping channel — alert when elite wallets BUY or EXIT
# FOMO_ENABLED=1
# FOMO_POLL_SEC=10
# FOMO_ALERT_TELEGRAM=1
# Optional dedicated Telegram channel/group for FOMO only:
# TELEGRAM_FOMO_CHAT_ID=-100xxxxxxxxxx
# HELIUS_API_KEY=...   # strongly recommended for FOMO speed/reliability

